# ============================================================
# DOCKER / HOST PATHS
# ============================================================

# Docker application/config storage
BASE_PATH=C:/Docker/appdata

# Temporary transcoding/cache storage
TRANSCODE_PATH=C:/Docker/transcode

# ============================================================
# STORAGE DRIVES
# Change these if Windows assigns different drive letters.
# ============================================================

# 500 GB - Cloud storage
CLOUD_PATH=D:/

# 1 TB - Security camera / ZoneMinder DVR
DVR_PATH=E:/

# 2 TB - Television
TV_PATH=F:/

# 3 TB - Movies
MOVIES_PATH=G:/

# 500 GB - Games
# Intentionally unused by this Docker stack.
# GAMES_PATH=H:/

# ============================================================
# GENERAL
# ============================================================

TZ=America/Chicago

# LinuxServer containers
PUID=1000
PGID=1000

# ============================================================
# JELLYFIN
# ============================================================

JELLYFIN_URL=

# ============================================================
# WIZARR
# ============================================================

WIZARR_URL=

# ============================================================
# RADARR / SONARR
# ============================================================

RADARR_KEY=
SONARR_KEY=
LIDARR_KEY=
READARR_KEY=

# ============================================================
# QBITTORRENT
# ============================================================

QBIT_USER=
QBIT_PASS=

# ============================================================
# GLUETUN / VPN
# ============================================================

VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard

WIREGUARD_KEY=
WIREGUARD_ADD=

VPN_SERVER_CITIES=

WIREGUARD_MTU=1200

PUBLICIP_API=
PUBLICIP_TOKEN=

VPN_PORT_FORWARDING=true

# ============================================================
# GLUETUN DNS
# ============================================================

GLUETUN_DNS_UPSTREAM_RESOLVERS=gluetun

# ============================================================
# HOMARR
# ============================================================

HOMARR_KEY=
HOMARR_NEXTAUTH_SECRET=

HOMARR_AUTH_PROVIDERS=credentials

HOMARR_OIDC_ISSUER=
HOMARR_OIDC_LOGOUT_REDIRECT_URL=
HOMARR_OIDC_CLIENT_ID=
HOMARR_OIDC_CLIENT_SECRET=
HOMARR_OIDC_CLIENT_NAME=OIDC
HOMARR_OIDC_AUTO_LOGIN=false
HOMARR_OIDC_SCOPE=openid email profile groups
HOMARR_OIDC_GROUPS_ATTRIBUTE=groups
HOMARR_OIDC_NAME_ATTRIBUTE=
HOMARR_OIDC_FORCE_USERINFO=false
HOMARR_OIDC_ENABLE_DANGEROUS_ACCOUNT_LINKING=false

# ============================================================
# JELLYSTAT
# ============================================================

JELLYSTATDB_USER=postgres
JELLYSTATDB_PASS=password
JWT_SECRET=my-secret-jwt-key

# ============================================================
# DISPATCHARR
# ============================================================

# Dispatcharr will use the VPN network when enabled.
